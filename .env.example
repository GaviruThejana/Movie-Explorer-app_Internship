# Copy this file to `.env` and paste your TMDb credentials.
# Get a free key at https://www.themoviedb.org/settings/api
#
# Either value works:
#   - the v3 "API Key" (32 hex characters), or
#   - the v4 "API Read Access Token" (a long string starting with "eyJ")
REACT_APP_TMDB_API_KEY=your_actual_api_key_here
